    <!-- Fahnen-Stempel / Fuß -->
    <ellipse class="fill" cx="60" cy="96" rx="5" ry="3.5"/>

    <!-- Dreiecks-Fahne -->
    <path class="thin" d="M60 36 L88 48 L60 60 Z"/>
  </g>

</svg>