  "btnhexagon": {
    "type": "button",
    "id": "btnhexagon",
    "x": 20,
    "y": 466,
    "width": 280,
    "height": 48,
    "z": 30,
    "text": "Hexagon",
    "clickRoutine": [
      {
        "func": "SELECT",
        "property": "id",
        "value": "piece"
      },
      {
        "func": "SET",
        "property": "dragLimit",
        "value": {
          "alignX": 0.5,
