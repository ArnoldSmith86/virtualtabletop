  "intro": {
    "id": "intro",
    "x": 20,
    "y": 68,
    "width": 280,
    "height": 260,
    "css": "font-size: 19px;",
    "movable": false,
    "movableInEdit": false,
    "clickable": false,
    "layer": -1,
    "z": 10,
    "html": "A rectangle is not always the shape you want. <b>dragLimit</b> also takes a condition: an inequality in x and y - the point of the widget the limit holds - that has to stay true while it is dragged. <br><br>Every example here sets <b>alignX</b> and <b>alignY</b> to 0.5, so that point is the middle of the piece and the shape drawn is where its middle can go."
  },
  "btnsides": {
    "type": "button",
    "id": "btnsides",
    "x": 20,
    "y": 350,
    "width": 280,
    "height": 48,
    "z": 30,
    "text": "Four sides",
    "clickRoutine": [
      {
        "func": "SELECT",
        "property": "id",
        "value": "piece"
      },
      {
        "func": "SET",
        "property": "dragLimit",
        "value": {
          "alignX": 0.5,
          "alignY": 0.5,
          "condition": [
            "x > 450",
            "x < 1150",
            "y > 175",
            "y < 825"
          ]
        }
      },
      {
        "func": "SET",
        "property": "x",
        "value": 770
      },
      {
        "func": "SET",
        "property": "y",
        "value": 470
      },
      {
        "func": "SELECT",
        "property": "shape",
        "value": true
      },
      {
        "func": "SET",
        "property": "css",
        "value": "display: none"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "shapeRect"
      },
      {
        "func": "SET",
        "property": "css",
        "value": "${PROPERTY show OF shapeRect}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "codePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "\"dragLimit\": {\n  \"alignX\": 0.5,\n  \"alignY\": 0.5,\n  \"condition\": [\n    \"x > 450\",\n    \"x < 1150\",\n    \"y > 175\",\n    \"y < 825\"\n  ]\n}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "notePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "The rectangle minX/maxX/minY/maxY already make, written as four conditions instead. Nothing is won here - but every line is an expression, so a side like this can depend on anything the game knows."
      }
    ]
  },
