      },
      {
        "func": "SET",
        "property": "text",
        "value": "A disc around the middle of the room, radius 500. Push the piece against the edge and it slides along the circle instead of stopping - a refused position puts the widget where its area comes closest to the mouse."
      }
    ]
  },
  "btnhexagon": {
    "type": "button",
    "id": "btnhexagon",
    "x": 20,
    "y": 466,
    "width": 280,
    "height": 48,
    "z": 30,
    "text": "Hexagon",
    "clickRoutine": [
      {
        "func": "SELECT",
        "property": "id",
        "value": "piece"
      },
      {
        "func": "SET",
        "property": "dragLimit",
        "value": {
          "minX": "550 - width/2",
          "maxX": "1050 - width/2",
          "condition": [
            "abs(y + height/2 - 500) < 250 * sqrt(3)/2",
            "abs(y + height/2 - 500) < sqrt(3) * (250 - abs(x + width/2 - 800))"
          ]
        }
      },
      {
        "func": "SET",
        "property": "x",
        "value": 770
      },
      {
        "func": "SET",
        "property": "y",
        "value": 470
      },
      {
        "func": "SELECT",
        "property": "shape",
        "value": true
      },
      {
        "func": "SET",
        "property": "css",
        "value": "display: none"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "shapeHex"
      },
      {
        "func": "SET",
        "property": "css",
        "value": "${PROPERTY show OF shapeHex}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "codePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "\"dragLimit\": {\n  \"minX\": \"550 - width/2\",\n  \"maxX\": \"1050 - width/2\",\n  \"condition\": [\n    \"abs(y + height/2 - 500)\n      < 250 * sqrt(3)/2\",\n    \"abs(y + height/2 - 500)\n      < sqrt(3) * (250\n      - abs(x + width/2 - 800))\"\n  ]\n}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "notePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "A regular hexagon, 500 across, using both halves at once: the two upright sides are minX and maxX, the flat top and bottom are the first condition, and all four slanted sides are the second one - one abs() folds it left to right, the other top to bottom."
      }
    ]
  },
