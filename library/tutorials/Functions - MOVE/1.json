    },
    "pilesGapX": 40
  },
  "text2": {
    "id": "text2",
    "x": 705,
    "y": 450,
    "width": 640,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "A &quotmultipleSpread&quot holder: &quotgroupStart&quot and &quotgroupEnd&quot deal the two cards as a new group at the start or the end. &quotpileBottom&quot and &quotpileTop&quot add them to the first or last group that is already there."
  },
