  "overview": {
    "id": "overview",
    "x": 108,
    "y": 80,
    "width": 1400,
    "height": 150,
    "css": "font-size: 25px",
    "html": "A pile in a holder that arranges piles takes the holder's <b>stackOffsetX</b> and <b>stackOffsetY</b> for its own cards, so a tableau column fans out the way the holder says without a property on the pile. <b>spreadMin</b> keeps that offset for the topmost cards only - the ones below them are squeezed to a tenth of it, so a long pile stays readable instead of running off the table. Both are inherited, and both can be set on a single pile instead.",
    "movable": false,
    "movableInEdit": false,
    "clickable": false,
    "layer": -3
  },
