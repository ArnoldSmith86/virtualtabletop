  "overview": {
    "id": "overview",
    "x": 108,
    "y": 80,
    "width": 1400,
    "height": 150,
    "css": "font-size: 25px",
    "html": "A holder that spreads its cards out - one with a <b>stackOffsetX</b> or <b>stackOffsetY</b> - used to refuse piles: cards dropped onto each other stayed separate and a pile dropped in was emptied out card by card. Switch <b>allowPiles</b> on and the holder arranges piles instead. Try both holders below. Pressing <b>ctrl-j</b> switches to edit mode with the JSON editor open, where the difference between them is the one property - <b>ctrl-j</b> again brings you back here.",
    "movable": false,
    "movableInEdit": false,
    "clickable": false,
    "layer": -3
  },
