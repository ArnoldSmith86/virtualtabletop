  "overview": {
    "id": "overview",
    "x": 108,
    "y": 80,
    "width": 1400,
    "height": 150,
    "css": "font-size: 25px",
    "html": "Where the next pile begins is up to the holder. <b>pilesGapX</b> and <b>pilesGapY</b> start it behind the cards of the one before it, plus that many pixels - so a pile that grows pushes the rest along. <b>pilesOffsetX</b> and <b>pilesOffsetY</b> put it at a fixed distance from the previous one instead, no matter how many cards it holds. A gap wins over an offset on the same axis, and with neither of them the piles are placed flush, one right after the other.",
    "movable": false,
    "movableInEdit": false,
    "clickable": false,
    "layer": -3
  },
