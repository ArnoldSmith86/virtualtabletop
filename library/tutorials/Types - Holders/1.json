  "text5": {
    "id": "text5",
    "x": 760,
    "y": 770,
    "width": 700,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "Deal some cards and drag them around. Dropped onto each other in the small holder they stay a pile, and a pile dropped into any of the wider holders is emptied out onto the row. The <i>gridColumns</i> button alternately pins the wrap of the third holder (the one directly above) to two cards per row or sets it back to null."
  },
  "shadowButton": {
    "id": "shadowButton",
    "type": "button",
    "x": 387,
    "y": 770,
    "width": 170,
    "height": 50,
    "text": "dropShadow true",
    "clickRoutine": [
      {
        "func": "IF",
        "operand1": "${PROPERTY dropShadow OF holder1}",
        "operand2": true,
        "thenRoutine": [
          {
            "func": "SELECT",
            "property": "id",
            "relation": "in",
            "value": [
              "holder1",
              "holder2",
              "holder3",
              "holder4"
            ]
          },
          {
            "func": "SET",
            "property": "dropShadow",
            "value": false
          },
          {
            "func": "SET",
            "collection": "thisButton",
            "property": "text",
            "value": "dropShadow false"
          }
        ],
        "elseRoutine": [
          {
            "func": "SELECT",
            "property": "id",
            "relation": "in",
            "value": [
              "holder1",
              "holder2",
              "holder3",
              "holder4"
            ]
          },
          {
            "func": "SET",
            "property": "dropShadow",
            "value": true
          },
          {
            "func": "SET",
            "collection": "thisButton",
            "property": "text",
            "value": "dropShadow true"
          }
        ]
      }
    ]
  },
