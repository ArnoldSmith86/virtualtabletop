  },
  "text2": {
    "id": "text2",
    "x": 551,
    "y": 650,
    "width": 400,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "Cards scatter too. Deal a few. Each one lands on a free spot with its own tilt. Once the tray gets crowded the pieces overlap as little as possible instead of spilling past the border."
  },
  "holder3": {
    "type": "holder",
