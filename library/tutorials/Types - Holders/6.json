  "text1": {
    "id": "text1",
    "x": 61,
    "y": 650,
    "width": 440,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "Click a die, or the button below, to roll it. Every roll also moves it onto a fresh free spot. The &quottransitions&quot class was added to each die and the related CSS is applied under the Game Settings -> Global Room CSS area to enhance the effect."
  },
  "holder2": {
    "type": "holder",
