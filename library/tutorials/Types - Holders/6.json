  },
  "text3": {
    "id": "text3",
    "x": 1021,
    "y": 650,
    "width": 420,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "Drag the checkers around. A piece dropped on a free spot keeps exactly that spot, one dropped onto another piece hops to a random free one. Pieces never overlap so long as there is space."
  },
  "button1": {
    "id": "button1",
