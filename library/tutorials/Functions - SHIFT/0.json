  "overview": {
    "id": "overview",
    "x": 108,
    "y": 80,
    "width": 1400,
    "height": 150,
    "layer": -3,
    "z": 129,
    "movable": false,
    "movableInEdit": false,
    "css": "font-size: 25px; ",
    "html": "SHIFT is used to move widgets between the holders and seats listed in <b>holders</b>, which defaults to ${activeSeats}. Click the oval buttons below to cycle through the options for the various parameters. Press the round SHIFT button at any time to move the widgets in the examples. For seats, the function uses the holder linked in the <b>hand</b> property of the seat. Empty seats are skipped."
  },
  "button3": {
    "type": "button",
    "id": "button3",
    "x": 953,
    "y": 194,
    "z": 22840,
    "clickRoutine": [
      {
        "func": "IF",
        "operand1": "${PROPERTY text}",
        "operand2": "forward",
        "thenRoutine": [
          {
            "func": "SET",
            "collection": "thisButton",
            "property": "text",
            "value": "backward"
          }
        ],
        "elseRoutine": [
          {
            "func": "IF",
            "operand1": "${PROPERTY text}",
            "operand2": "backward",
            "thenRoutine": [
              {
                "func": "SET",
                "collection": "thisButton",
                "property": "text",
                "value": "random"
              }
            ],
            "elseRoutine": [
              {
                "func": "SET",
                "collection": "thisButton",
                "property": "text",
                "value": "forward"
              }
            ]
          }
        ]
      }
    ],
    "height": 40,
    "text": "forward"
  },
  "button4": {
    "type": "button",
