  "text1": {
    "id": "text1",
    "x": 14,
    "y": 270,
    "width": 350,
    "z": 185,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "<b>source</b>: Specifies which widgets in each holder are moved. Defaults to &quotall&quot. If set to &quottop&quot it will just move the top widget. It can also be set to a named collection to move all widgets in that collection.",
    "layer": -3
  },
  "button1": {
    "type": "button",
    "id": "button1",
    "x": 129,
    "y": 194,
    "z": 22841,
    "clickRoutine": [
      {
        "func": "IF",
        "operand1": "${PROPERTY text}",
        "operand2": "all",
        "thenRoutine": [
          {
            "func": "SET",
            "collection": "thisButton",
            "property": "text",
            "value": "top"
          }
        ],
        "elseRoutine": [
          {
            "func": "SET",
            "collection": "thisButton",
            "property": "text",
            "value": "all"
          }
        ]
      }
    ],
    "height": 40,
    "text": "all"
  },
  "text2": {
    "id": "text2",
    "x": 421,
    "y": 270,
    "width": 350,
    "z": 121,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "<b>interval</b>: Specifies how many positions along <b>holders</b> the widget(s) move. Defaults to 1.",
    "layer": -3
  },
  "text3": {
    "id": "text3",
    "x": 836,
    "y": 270,
    "width": 350,
    "z": 9732,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "<b>direction</b>: Specifies whether the widgets move forwards or backwards along <b>holders</b>, or to a random other entry. Defaults to &quotforward&quot.",
    "layer": -3
  },
  "text4": {
    "id": "text4",
    "x": 1234,
    "y": 270,
    "width": 350,
