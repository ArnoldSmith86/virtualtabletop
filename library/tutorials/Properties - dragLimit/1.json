      {
        "func": "SET",
        "property": "css",
        "value": "${PROPERTY show OF shapeHex}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "codePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "\"dragLimit\": {\n  \"alignX\": 0.5, \"alignY\": 0.5,\n  \"minX\": 590, \"maxX\": 1010,\n  \"condition\": [\n    \"abs(y - 530) < 210 * sqrt(3)/2\",\n    \"abs(y - 530)\n      < sqrt(3) * (210 - abs(x - 800))\"\n  ]\n}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "notePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "A regular hexagon, 420 across, using both halves at once: the two upright sides are minX and maxX, the flat top and bottom are the first condition, and all four slanted sides are the second one - one abs() folds it left to right, the other top to bottom."
      }
    ]
  },
