        "value": "${PROPERTY show OF shapeRect}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "codePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "\"dragLimit\": {\n  \"alignX\": 0.5, \"alignY\": 0.5,\n  \"condition\": [\n    \"x > 460\", \"x < 1140\",\n    \"y > 350\", \"y < 710\"\n  ]\n}"
      },
      {
        "func": "SELECT",
        "property": "id",
        "value": "notePanel"
      },
      {
        "func": "SET",
        "property": "text",
        "value": "The rectangle minX/maxX/minY/maxY already make, written as four conditions instead. Nothing is won here - but every line is an expression, so a side like this can depend on anything the game knows."
      }
    ]
  },
