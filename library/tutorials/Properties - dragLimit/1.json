  "btnsides": {
    "type": "button",
    "id": "btnsides",
    "x": 60,
    "y": 282,
    "width": 280,
    "height": 50,
    "z": 30,
    "text": "Four sides",
    "clickRoutine": [
      {
        "func": "SELECT",
        "property": "id",
        "value": "piece"
      },
      {
        "func": "SET",
        "property": "dragLimit",
