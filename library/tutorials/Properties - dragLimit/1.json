  "btnhexagon": {
    "type": "button",
    "id": "btnhexagon",
    "x": 660,
    "y": 282,
    "width": 280,
    "height": 50,
    "z": 30,
    "text": "Hexagon",
    "clickRoutine": [
      {
        "func": "SELECT",
        "property": "id",
        "value": "piece"
      },
      {
        "func": "SET",
        "property": "dragLimit",
        "value": {
          "alignX": 0.5,
          "alignY": 0.5,
          "minX": 590,
          "maxX": 1010,
          "condition": [
            "abs(y - 530) < 210 * sqrt(3)/2",
            "abs(y - 530) < sqrt(3) * (210 - abs(x - 800))"
          ]
        }
      },
