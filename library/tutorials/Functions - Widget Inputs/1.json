  "text1": {
    "id": "text1",
    "type": "label",
    "x": 160,
    "y": 500,
    "width": 320,
    "height": 130,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": "font-size: 22px;",
    "text": "<b>fromHolder</b> moves what is inside the holders it names. <i>count</i> decides how many per holder \u2013 this one moves a single token per click."
  },
  "text2": {
    "id": "text2",
    "type": "label",
    "x": 600,
    "y": 500,
    "width": 320,
    "height": 130,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": "font-size: 22px;",
    "text": "<b>target</b> moves the widgets themselves, wherever they are. The two loose tokens on the right have no holder to be taken out of."
  },
  "text3": {
    "id": "text3",
    "type": "label",
    "x": 1020,
    "y": 500,
    "width": 340,
    "height": 130,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": "font-size: 22px;",
    "text": "<b>toHolder</b> is the destination and takes a list or a collection too. Point it at a seat and the widgets land in that seat's hand."
  },
  "text4": {
    "id": "text4",
    "type": "label",
    "x": 108,
    "y": 690,
    "width": 1400,
    "height": 150,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": "font-size: 25px;",
    "text": "The old names still work: a game written with <i>from</i>, <i>to</i> and <i>collection</i> keeps running unchanged, and so does a plain widget id where a list is expected. The new names are what the editor writes from now on, so every function reads the same way."
  }
