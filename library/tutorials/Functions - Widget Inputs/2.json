  "text3": {
    "id": "text3",
    "x": 980,
    "y": 640,
    "width": 480,
    "height": 290,
    "layer": -3,
    "movable": false,
    "movableInEdit": false,
    "css": {
      "font-size": "22px"
    },
    "html": "A <b>seat</b> passed to <b>holder</b> stands for what lies in its hand and belongs to its player &ndash; not for everything in the hand. Move the two tokens into the seat first: MOVE into a seat puts them into its hand and gives them to the player sitting there. Only then does the second button find them. While nobody is sitting in the seat, both buttons find nothing at all, which is what makes a seat safe to name even before the game starts."
  }
